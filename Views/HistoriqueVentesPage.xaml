<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProductSnap.Maui.ViewModels"
             xmlns:models="clr-namespace:ProductSnap.Maui.Models"
             x:Class="ProductSnap.Maui.Views.HistoriqueVentesPage"
             x:DataType="vm:HistoriqueVentesViewModel"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Historique des ventes" FontSize="20" FontAttributes="Bold" />
        <Label Text="Toutes vos ventes récentes" Style="{StaticResource Caption}" />
        <Label Text="{Binding Erreur}" Style="{StaticResource Caption}" />

        <CollectionView ItemsSource="{Binding Ventes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Vente">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10">
                                <Image Source="inventory.svg" WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding NomProduit}"
                                       FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding Minutes, StringFormat='Il y a {0} min'}"
                                       Style="{StaticResource Caption}" />
                                <Label Text="{Binding Quantite, StringFormat='Quantité : {0}'}"
                                       Style="{StaticResource Caption}" />
                                <Label Text="{Binding ModePaiement, StringFormat='Paiement : {0}'}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Montant, StringFormat='+{0:N0} F'}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Success}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>