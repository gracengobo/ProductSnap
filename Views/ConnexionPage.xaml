<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProductSnap.Maui.ViewModels"
             x:Class="ProductSnap.Maui.Views.ConnexionPage"
             x:DataType="vm:ConnexionViewModel"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header bleu en haut -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    Padding="24,60,24,40">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="{StaticResource Secondary}"
                            StrokeThickness="0"
                            WidthRequest="52" HeightRequest="52"
                            StrokeShape="RoundRectangle 14">
                        <Image Source="cameralight.svg" WidthRequest="28" HeightRequest="28"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="ProductSnap" FontSize="18"
                           FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Scannez. Vendez. Sans erreur."
                           FontSize="11" TextColor="White"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Carte de connexion -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Margin="12,-30,12,0"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Connexion" FontSize="14" FontAttributes="Bold" />
                    <Label Text="Accédez à votre espace boutique"
                           FontSize="10" TextColor="{StaticResource OnSurfaceVariant}" />

                    <Label Text="IDENTIFIANT CAISSE"
                           FontSize="9" FontAttributes="Bold"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Entry Placeholder="Email ou téléphone"
                           BackgroundColor="{StaticResource SurfaceContainerLow}"
                           Text="{Binding Email}" />

                    <Label Text="CODE CONFIDENTIEL"
                           FontSize="9" FontAttributes="Bold"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Entry Placeholder="Mot de passe"
                           IsPassword="True"
                           BackgroundColor="{StaticResource SurfaceContainerLow}"
                           Text="{Binding MotDePasse}" />

                    <Button Text="Se connecter →"
                            Command="{Binding SeConnecterCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="54" />

                    <Label Text="{Binding MessageErreur}"
                           TextColor="{StaticResource Error}"
                           FontSize="11"
                           IsVisible="{Binding HasErreur}"
                           HorizontalOptions="Center" />


                    <!-- Lien inscription -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,16,0,0">
                        <Label Text="Pas encore de compte ?"
                       FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Text="Créer un compte"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AllerInscriptionCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>