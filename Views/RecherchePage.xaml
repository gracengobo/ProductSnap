<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProductSnap.Maui.ViewModels"
             xmlns:models="clr-namespace:ProductSnap.Maui.Models"
             x:Class="ProductSnap.Maui.Views.RecherchePage"
             x:DataType="vm:RechercheViewModel"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="16" Spacing="12">

        <!-- Barre de recherche -->
        <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                StrokeThickness="0" Padding="12,4"
                StrokeShape="RoundRectangle 12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Image Grid.Column="0" Source="search.svg" WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1" Placeholder="Nom, code-barres, catégorie..."
                       Text="{Binding Recherche}"
                       BackgroundColor="Transparent" />
                <Button Grid.Column="2" Text="Scanner"
                       Command="{Binding OuvrirScannerCommand}"
                       VerticalOptions="Center" />
                <Button Grid.Column="3" Text="Ajouter"
                       Command="{Binding AjouterNouveauCommand}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Chips catégories -->
        <ScrollView Orientation="Horizontal">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Tous" Command="{Binding ChoisirCategorieCommand}"
                        CommandParameter="Tous" Padding="14,6" CornerRadius="16" />
                <Button Text="Alimentaire" Command="{Binding ChoisirCategorieCommand}"
                        CommandParameter="Alimentaire" Padding="14,6" CornerRadius="16" />
                <Button Text="Boisson" Command="{Binding ChoisirCategorieCommand}"
                        CommandParameter="Boisson" Padding="14,6" CornerRadius="16" />
                <Button Text="Hygiène" Command="{Binding ChoisirCategorieCommand}"
                        CommandParameter="Hygiène" Padding="14,6" CornerRadius="16" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Compteur -->
        <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding NbResultats, StringFormat='{0} articles répertoriés'}"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="{StaticResource OnSurfaceVariant}" />
            <Label Grid.Column="1" Text="{Binding Statut}"
                   FontSize="11" TextColor="{StaticResource Secondary}" />
        </Grid>

        <!-- Liste produits -->
        <CollectionView ItemsSource="{Binding Produits}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Produit">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    WidthRequest="52" HeightRequest="52"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10">
                                <Image Source="inventory.svg" WidthRequest="28" HeightRequest="28"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Nom}"
                                       FontSize="14" FontAttributes="Bold">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RechercheViewModel}}, Path=OuvrirProduitCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="{Binding CodeBarres}"
                                       FontSize="11"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Text="{Binding StatutStock}"
                                       FontSize="11"
                                       TextColor="{StaticResource Success}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Prix, StringFormat='{0:N0} F'}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="3" Text="Vendre"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RechercheViewModel}}, Path=AjouterCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    TextColor="{StaticResource Primary}"
                                    WidthRequest="36" HeightRequest="36"
                                    CornerRadius="10" FontSize="18" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>