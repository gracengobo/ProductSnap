<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProductSnap.Maui.ViewModels"
             xmlns:models="clr-namespace:ProductSnap.Maui.Models"
             x:Class="ProductSnap.Maui.Views.HistoriquePrixPage"
             x:DataType="vm:HistoriquePrixViewModel"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Text="Retour" Command="{Binding RetourCommand}" />
            <Label Grid.Column="1" Text="Historique des prix"
                   Style="{StaticResource H2}" VerticalOptions="Center" />
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Historique}">
            <CollectionView.EmptyView>
                <Label Text="{Binding Message}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Style="{StaticResource Caption}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoriquePrix">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding NomProduit}" FontAttributes="Bold" />
                                <Label Text="{Binding DateModification, StringFormat='{0:g}'}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding Prix, StringFormat='{0:N0} FCFA'}"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Partager CSV" Command="{Binding PartagerCommand}" />
            <Button Grid.Column="1" Text="Exporter CSV" Command="{Binding ExporterCommand}" />
        </Grid>
    </Grid>
</ContentPage>
