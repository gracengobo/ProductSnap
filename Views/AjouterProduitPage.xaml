<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProductSnap.Maui.ViewModels"
             x:Class="ProductSnap.Maui.Views.AjouterProduitPage"
             x:DataType="vm:AjouterProduitViewModel"
             Title="Nouveau produit"
             BackgroundColor="{StaticResource Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Ajouter au catalogue" Style="{StaticResource H2}" />
            <Label Text="Les informations et le stock seront conservés sur cet appareil."
                   Style="{StaticResource Caption}" />

            <Label Text="Code-barres" />
            <Entry Text="{Binding CodeBarres}" IsReadOnly="True" Keyboard="Numeric" />

            <Label Text="Nom du produit *" />
            <Entry Text="{Binding Nom}" Placeholder="Ex. Riz parfumé 5 kg" />

            <Label Text="Catégorie" />
            <Entry Text="{Binding Categorie}" Placeholder="Ex. Alimentaire" />

            <Label Text="Prix de vente (FCFA) *" />
            <Entry Text="{Binding PrixVente}" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Stock initial" />
            <Entry Text="{Binding StockInitial}" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Prix d'achat unitaire (FCFA)" />
            <Entry Text="{Binding PrixAchat}" Keyboard="Numeric" Placeholder="0" />

            <Button Text="Enregistrer le produit"
                    Command="{Binding EnregistrerCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButton}" />
            <Button Text="Annuler" Command="{Binding AnnulerCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
