<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProductSnap.Maui.ViewModels"
             x:Class="ProductSnap.Maui.Views.ScannerPage"
             x:DataType="vm:ScannerViewModel"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Barre supérieure -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←"
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        TextColor="{StaticResource Primary}"
                        FontSize="20" WidthRequest="44" HeightRequest="44"
                        CornerRadius="12" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="LECTURE EAN / UPC" FontSize="10" FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}"
                           HorizontalOptions="Center" />
                    <Label Text="Scanner un produit" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Saisie"
                        Command="{Binding SaisieManuelleCommand}"
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        TextColor="{StaticResource OnSurfaceVariant}"
                        FontSize="20" WidthRequest="44" HeightRequest="44"
                        CornerRadius="12" />
            </Grid>

            <!-- Instructions -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Scannez le code-barres"
                       FontSize="16" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Cadrez un code EAN-13 / UPC-A lisible"
                       FontSize="12"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Viewfinder -->
            <Border HeightRequest="400"
                    BackgroundColor="#293040"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                <Grid>
                    <Label Text="BARCODE"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="#66FFFFFF"
                           HorizontalOptions="Center" VerticalOptions="Center" />

                    <Border BackgroundColor="#F9F9FF"
                            StrokeThickness="0"
                            Padding="10,5"
                            HorizontalOptions="Start" VerticalOptions="Start"
                            Margin="12"
                            StrokeShape="RoundRectangle 20">
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse Fill="{StaticResource Secondary}"
                                     WidthRequest="8" HeightRequest="8" />
                            <Label Text="Décodage local hors ligne"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Cadre de visée -->
                    <Grid HorizontalOptions="Center" VerticalOptions="Center"
                          WidthRequest="250" HeightRequest="250">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,*,Auto">
                            <Border Grid.Row="0" Grid.Column="0"
                                    WidthRequest="32" HeightRequest="32"
                                    Stroke="{StaticResource Secondary}"
                                    StrokeThickness="3"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 12,0,0,0" />
                            <Border Grid.Row="0" Grid.Column="2"
                                    WidthRequest="32" HeightRequest="32"
                                    Stroke="{StaticResource Secondary}"
                                    StrokeThickness="3"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 0,12,0,0" />
                            <Border Grid.Row="2" Grid.Column="0"
                                    WidthRequest="32" HeightRequest="32"
                                    Stroke="{StaticResource Secondary}"
                                    StrokeThickness="3"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 0,0,0,12" />
                            <Border Grid.Row="2" Grid.Column="2"
                                    WidthRequest="32" HeightRequest="32"
                                    Stroke="{StaticResource Secondary}"
                                    StrokeThickness="3"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 0,0,12,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bouton principal -->
            <Button Text="PRENDRE UNE PHOTO DU CODE"
                    Command="{Binding PrendrePhotoCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54" />

            <!-- Boutons secondaires -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Choisir une photo"
                        Command="{Binding OuvrirGalerieCommand}"
                        BackgroundColor="{StaticResource SurfaceContainerLow}"
                        TextColor="{StaticResource OnSurface}"
                        CornerRadius="12"
                        HeightRequest="48" />
                <Button Grid.Column="1" Text="Saisie du code"
                        Command="{Binding SaisieManuelleCommand}"
                        BackgroundColor="{StaticResource SurfaceContainerLow}"
                        TextColor="{StaticResource OnSurface}"
                        CornerRadius="12"
                        HeightRequest="48" />
            </Grid>

            <Label Text="{Binding Message}"
                   FontSize="12"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>